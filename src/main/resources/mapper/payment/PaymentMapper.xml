<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.finalProject.ali.payment.mapper.PaymentMapper">
    <insert id="insert">
        INSERT INTO payment(
            payment_id,
            order_id,
            payment_method,
            status,
            amount
        ) VALUES (
            #{paymentId},
            #{orderId},
            #{paymentMethod},
            #{status},
            #{amount}
        )
    </insert>

</mapper>
