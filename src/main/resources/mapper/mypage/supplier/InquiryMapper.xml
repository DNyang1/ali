<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.finalProject.ali.mypage.supplier.inquiry.dao.SupplierInquiryDAO">

    <select id="countBySupplierAndStatus" resultType="long">
        SELECT COUNT(*)
        FROM inquiry i
        JOIN products p ON i.product_id = p.product_id
        WHERE p.supplier_id = #{supplierId}
        AND i.status = #{status}
    </select>

</mapper>
