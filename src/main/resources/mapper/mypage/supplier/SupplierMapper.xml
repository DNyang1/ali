<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.finalProject.ali.product.dao.SupplierDAO">

    <select id="findSupplierIdByUserId" resultType="string">
        SELECT supplier_id
        FROM supplier
        WHERE user_id = #{userId}
    </select>

</mapper>
