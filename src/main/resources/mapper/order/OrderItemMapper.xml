<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.finalProject.ali.cart.mapper.OrderItemMapper">
    <insert id="insert" parameterType="com.finalProject.ali.order.domain.OrderItem"
            useGeneratedKeys="true" keyProperty="orderItemId">
        INSERT INTO order_item (order_id, sku_id, quantity, unit_price, create_at)
        VALUES (#{orderId}, #{skuId}, #{quantity}, #{unitPrice}, NOW())
    </insert>

</mapper>
