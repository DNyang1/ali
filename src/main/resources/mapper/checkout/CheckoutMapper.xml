<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.finalProject.ali.checkout.mapper.CheckoutMapper">
    <select id="findItemInfo" parameterType="string" resultType="com.finalProject.ali.checkout.dto.CheckoutItem">
        SELECT
            s.sku_id       AS skuId,
            s.product_id   AS productId,
            p.product_name AS productName
        FROM sku s
        JOIN products p
            ON s.product_id = p.product_id
        WHERE s.sku_id = #{skuId}
        LIMIT 1
    </select>

</mapper>
