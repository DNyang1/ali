<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.finalProject.ali.product.category.dao.CategoryDAO">
    <select id="selectMainCategories" resultType="categoryDTO">
        SELECT
            category_id AS categoryId,
            category_name AS categoryName
        FROM category
        WHERE parent_id IS NULL
        ORDER BY created_at
    </select>
</mapper>
