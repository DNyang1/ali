<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.finalProject.ali.products.dao.ProductsDAO">
    <select id="productList" resultType="com.finalProject.ali.products.dto.ProductsDTO">
        SELECT
            product_id,
            category_id,
            product_name,
            description,
            is_customizable,
            moq,
            created_at,
            updated_at
        FROM products
        ORDER BY created_at DESC
    </select>
</mapper>
